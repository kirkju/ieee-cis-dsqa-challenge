# One line-ending convention on every machine: text files are LF in the
# repository and in the working tree. A submission zip is built from the
# working tree, so without this the same commit produces different bytes on
# Windows (CRLF, through core.autocrlf) and on Linux (LF).
* text=auto eol=lf

# Rows are appended to the experiment ledger from several machines and
# branches. A union merge keeps the lines of both sides instead of reporting
# a conflict.
results/experiments.jsonl merge=union
